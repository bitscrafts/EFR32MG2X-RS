% ========== CUSTOM COMMANDS FOR EMBEDDED CONTENT ==========

% Show file contents
\newcommand{\showfile}[2]{
    \begin{notebox}
        \textbf{File:} \filepath{#1}
        \\[0.5em]
        \inputminted{text}{#2}
    \end{notebox}
}

% Show command output
\newcommand{\commandoutput}[2]{
    \begin{tipbox}
        \textbf{Command:} \texttt{#1}
        \\[0.5em]
        \begin{Verbatim}[fontsize=\small, frame=single]
#2
        \end{Verbatim}
    \end{tipbox}
}

% Note about unsafe code
\newcommand{\unsafenote}{
    \begin{warningbox}
        \textbf{⚠ Unsafe Code}: The following code uses \codeinline{unsafe} blocks.
        This is necessary for direct hardware manipulation in embedded systems.
        Always document why unsafe is required and what invariants must be maintained.
    \end{warningbox}
}

% Example output
\newenvironment{exampleoutput}{
    \begin{tipbox}
        \textbf{Expected Output:}
        \\[0.5em]
        \begin{minipage}{\textwidth}
        \begin{Verbatim}[fontsize=\small]
}{
        \end{Verbatim}
        \end{minipage}
    \end{tipbox}
}

% Key takeaways at end of chapter
\newenvironment{keytakeaways}{
    \section*{Key Takeaways}
    \begin{itemize}
}{
    \end{itemize}
}

