% Preamble for "Implementing Rust Support for Embedded Hardware"
% Technical book template optimized for code and diagrams

% ========== FONTS AND ENCODING ==========
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage{lmodern}

% ========== PAGE LAYOUT ==========
\usepackage[margin=1in, inner=1.5in, outer=1in, top=1in, bottom=1.5in,
            marginparwidth=1.2in, marginparsep=0.2in]{geometry}
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\thepage\quad\leftmark}
\fancyhead[RO]{\rightmark\quad\thepage}
\fancyfoot[C]{}
\renewcommand{\headrulewidth}{0.4pt}

% ========== COLORS ==========
\usepackage[svgnames]{xcolor}

% Define color scheme for the book
\definecolor{rustblue}{RGB}{0, 123, 194}
\definecolor{rustorange}{RGB}{255, 140, 0}
\definecolor{codebackground}{RGB}{248, 248, 248}
\definecolor{emphasis}{RGB}{230, 242, 255}
\definecolor{warning}{RGB}{255, 230, 230}
\definecolor{tip}{RGB}{230, 255, 230}
\definecolor{border}{RGB}{200, 200, 200}

% ========== HYPERLINKS ==========
\usepackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=rustblue,
    filecolor=rustblue,
    urlcolor=rustblue,
    citecolor=rustblue,
    pdftitle={Implementing Rust Support for Embedded Hardware},
    pdfauthor={Marcelo Correa},
    pdfsubject={Embedded Rust Programming},
    pdfkeywords={Rust, Embedded, EFR32MG24, HAL, PAC}
}

% ========== CODE LISTING (MINTED) ==========
\usepackage{minted}
\setminted{
    fontsize=\small,
    baselinestretch=0.8,
    frame=leftline,
    framesep=1em,
    framerule=2pt,
    rulecolor=rustblue,
    bgcolor=codebackground,
    linenos=true,
    numbersep=0.5em,
    breaklines=true,
    breakanywhere=true,
    xleftmargin=1em
}

% Define Rust language style
\newminted{rust}{linenos=true, style=monokai}
\newminted{bash}{linenos=false, style=monokai}
\newmintinline{rust}{bgcolor=codebackground}

% ========== GRAPHICS ==========
\usepackage{graphicx}
\usepackage{subcaption}
\usepackage{wrapfig}
\usepackage{caption}
\usepackage{float}  % For H placement specifier
\captionsetup{font=small,labelfont=bf}

% ========== DIAGRAMS (TIKZ) ==========
\usepackage{tikz}
\usetikzlibrary{shapes.geometric, arrows.meta, positioning, fit, calc, shadows, patterns}
\usepackage{forest}  % For directory tree diagrams
\usepackage{pgfplots}
\pgfplotsset{compat=1.17}

% ========== TABLES ==========
\usepackage{array}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{multirow}
\usepackage{multicol}

% ========== VERBATIM AND CODE ENVIRONMENTS ==========
\usepackage{fancyvrb}
\usepackage{verbatim}
\usepackage{listings}
\renewcommand{\lstlistlistingname}{List of Code Listings}
\renewcommand{\lstlistingname}{Code Listing}

% ========== MATH ==========
\usepackage{amsmath}
\usepackage{amssymb}
\usepackage{amsfonts}

% ========== MARGIN NOTES ==========
\usepackage{marginnote}
\reversemarginpar  % Put notes in outer margin

% Custom margin note commands
\newcommand{\marginwarning}[1]{%
    \marginnote{\textcolor{warning}{\textbf{⚠}}\ #1}
    [0.5em]}

\newcommand{\margintip}[1]{%
    \marginnote{\textcolor{tip}{\textbf{✓}}\ #1}
    [0.5em]}

\newcommand{\margincode}[1]{%
    \marginnote{\begin{minipage}{\marginparwidth}\ttfamily\fontsize{7pt}{8pt}\selectfont #1\end{minipage}}
    [0.5em]}

\newcommand{\marginnotebox}[2][emphasis]{%
    \marginnote{\begin{minipage}{\marginparwidth}
        \setlength{\fboxsep}{0.5em}
        \colorbox{#1}{\parbox{\dimexpr\marginparwidth-1em}{\small\bfseries#2}}
    \end{minipage}}
    [0.5em]}

% ========== CUSTOM ENVIRONMENTS ==========

% Note box environment
\usepackage{mdframed}
\newmdenv[
    linewidth=0pt,
    backgroundcolor=emphasis,
    topline=false,
    bottomline=false,
    rightline=false,
    leftline=4pt,
    linecolor=rustblue,
    innertopmargin=0.5em,
    innerbottommargin=0.5em,
    innerrightmargin=1em,
    innerleftmargin=1em
]{notebox}

% Warning box environment
\newmdenv[
    linewidth=0pt,
    backgroundcolor=warning,
    topline=false,
    bottomline=false,
    rightline=false,
    leftline=4pt,
    linecolor=red,
    innertopmargin=0.5em,
    innerbottommargin=0.5em,
    innerrightmargin=1em,
    innerleftmargin=1em
]{warningbox}

% Tip box environment
\newmdenv[
    linewidth=0pt,
    backgroundcolor=tip,
    topline=false,
    bottomline=false,
    rightline=false,
    leftline=4pt,
    linecolor=green,
    innertopmargin=0.5em,
    innerbottommargin=0.5em,
    innerrightmargin=1em,
    innerleftmargin=1em
]{tipbox}

% Exercise environment
\newcounter{exercise}[chapter]
\newenvironment{exercise}[1][]{
    \refstepcounter{exercise}
    \par\medskip\noindent
    \textbf{Exercise~\thechapter.\theexercise #1}\rmfamily\medskip
}{
    \medskip\par}

% Challenge environment
\newenvironment{challenge}{
    \par\medskip\noindent
    \begin{notebox}\textbf{\textcolor{rustorange}{Challenge}}:
}{
    \end{notebox}}

% ========== CHAPTER AND SECTION STYLING ==========
\usepackage{titlesec}

% Chapter styling
\titleformat{\chapter}[display]
    {\normalfont\huge\bfseries\color{rustblue}}
    {\filleft\Huge\thechapter}
    {0pt}{\filleft\MakeUppercase}[
        \vspace*{0.5em}
        \titlerule[2pt]
    ]

% Section styling
\titleformat{\section}
    {\normalfont\Large\bfseries\color{rustblue}}
    {\thesection}
    {1em}{}

% Subsection styling
\titleformat{\subsection}
    {\normalfont\large\bfseries\color{rustblue}}
    {\thesubsection}
    {1em}{}

% Subsubsection styling
\titleformat{\subsubsection}
    {\normalfont\normalsize\bfseries\color{rustblue}}
    {\thesubsubsection}
    {1em}{}

% ========== MINI TABLE OF CONTENTS ==========
\usepackage{minitoc}
\setcounter{minitocdepth}{2}  % Show sections and subsections
\mtcindent=0pt

% ========== TABLE OF CONTENTS STYLING ==========
\usepackage{titletoc}

% Chapter in TOC
\titlecontents{chapter}[0pt]
    {\vspace{0.5em}\bfseries\large}
    {\contentslabel{2em}}{}
    {\hfill\contentspage}
    [\vspace{0.2em}]

% Section in TOC
\titlecontents{section}[2em]
    {\vspace{0.1em}}
    {\contentslabel{2em}}{}
    {\hfill\contentspage}

% Subsection in TOC
\titlecontents{subsection}[4em]
    {\vspace{0.1em}}
    {\contentslabel{2em}}{}
    {\hfill\contentspage}

% ========== HEADER AND CHAPTER THUMBS ==========
\usepackage{everypage}

% Chapter thumbs (colored edges for quick navigation)
\newcommand{\chapthumb}[1]{
    \begin{tikzpicture}[remember picture,overlay]
        \node[fill=rustblue, minimum height=2cm, minimum width=1cm,
              anchor=north east, xshift=1cm, yshift=-1cm-
              3cm*#1]
              at (current page.north east) {};
        \node[fill=rustblue!70, minimum height=2cm, minimum width=0.5cm,
              anchor=north east, xshift=0.5cm, yshift=-1cm-
              3cm*#1]
              at (current page.north east) {};
    \end{tikzpicture}
}

% ========== CUSTOM MACROS ==========

% Rust code snippet with caption
\newcommand{\rustcodesnippet}[2]{
    \begin{listing}[H]
        \inputminted{rust}{#1}
        \caption{#2}
        \label{lst:#1}
    \end{listing}
}

% Bash command with explanation
\newcommand{\shellcmd}[1]{\indent\texttt{\$ #1}}

% File path formatting
\newcommand{\filepath}[1]{\textcolor{rustblue}{\texttt{#1}}}

% Register name formatting
\newcommand{\register}[1]{\texttt{\textbf{#1}}}

% Crate name formatting
\newcommand{\crate}[1]{\texttt{#1}}

% Highlight new concept
\newcommand{\newterm}[1]{\textcolor{rustorange}{\textbf{#1}}}

% Simple code inline - handles special characters
\newcommand{\codeinline}[1]{\colorbox{codebackground}{\texttt{\detokenize{#1}}}}

