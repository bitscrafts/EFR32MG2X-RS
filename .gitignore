# Book writing (documentation project, not code)
book/output/
book/project/*/target/
*.pdf
# ...except the book itself, which is delivered as a reading copy at the root of the repository. Build output
# stays ignored; this one file is the product.
!Implementing-Rust-Support-for-Embedded-Hardware-EFR32MG24.pdf
book/**/*.aux
book/**/*.log
book/**/*.out
book/**/*.toc

# Radio -sys crates: blobs and vendor headers (MSLA licensed, not in git)
**/blobs/*.a
**/blobs/*.o
**/blobs/*.lib
**/vendor/**/*.h
**/vendor/**/*.c

# Local temp work must not land in the repository
_tmp/

# Build artefacts and vendor packs never belong in the repository
*.hex
*.bin
*.pack
!scripts/**/*.hex
