% PAC/HAL/BSP Architecture Diagram
% Used in Chapter 1, Section 01.03

\begin{tikzpicture}[
    layer/.style={rectangle, draw=black, thick, minimum width=8cm, minimum height=1.5cm, font=\bfseries},
    arrow/.style={-Latex, thick, double},
    label/.style={font=\small\itshape}
]

    % Application Layer
    \node[layer, fill=rustblue!20] (app) at (0, 4.5) {Application Code};

    % BSP Layer
    \node[layer, fill=green!20] (bsp) at (0, 3) {Board Support Package (BSP)};

    % HAL Layer
    \node[layer, fill=yellow!20] (hal) at (0, 1.5) {Hardware Abstraction Layer (HAL)};

    % PAC Layer
    \node[layer, fill=red!20] (pac) at (0, 0) {Peripheral Access Crate (PAC)};

    % Hardware Layer
    \node[layer, fill=gray!20] (hw) at (0, -1.5) {Hardware Peripherals};

    % Arrows showing dependency
    \draw[arrow] (app) -- (bsp);
    \draw[arrow] (bsp) -- (hal);
    \draw[arrow] (hal) -- (pac);
    \draw[arrow] (pac) -- (hw);

    % Labels
    \node[label, left=2cm of app] {Application-Specific};
    \node[label, left=2cm of bsp] {Board-Specific};
    \node[label, left=2cm of hal] {Chip Family Specific};
    \node[label, left=2cm of pac] {Vendor Provided};

    % Portability indicators
    \node[font=\small, right=2cm of app] {User Code};
    \node[font=\small, right=2cm of bsp] {Board Mappings};
    \node[font=\small, right=2cm of hal] {Safe APIs};
    \node[font=\small, right=2cm of pac] {Register Access};
    \node[font=\small, right=2cm of hw] {Fixed by Hardware};
\end{tikzpicture}
