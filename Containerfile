# Containerfile for EFR32MG24 Embedded Rust Development
#
# A build environment that matches what CI installs, so a failure here is a failure there and the other way
# round. That parity is the point: the first version of this file pinned Rust 1.75 and omitted the ARM libc,
# the Rust target and python3, which meant the image could not run the gate and was three years of language
# features behind the code it was supposed to build.
#
# Usage:
#   podman build -t efr32mg24-builder -f Containerfile .
#   podman run --rm -v "$PWD":/build efr32mg24-builder bash scripts/gate.sh
#   podman run --rm -v "$PWD":/build efr32mg24-builder cargo build --release --target thumbv8m.main-none-eabihf

FROM docker.io/rust:1.99-slim

# The C toolchain the -sys crates need:
#   gcc-arm-none-eabi + libnewlib-arm-none-eabi  compile the vendored C and provide <string.h>
#   libclang-dev / clang                         bindgen, for the RAIL and Bluetooth headers
#   python3                                      the gate's checkers (check-copy-len.py, check-examples-build.sh)
#   openocd                                      flashing and the SWD readers (read-mailbox.sh, where.sh)
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-arm-none-eabi \
        libnewlib-arm-none-eabi \
        build-essential \
        pkg-config \
        libclang-dev \
        clang \
        llvm-dev \
        python3 \
        openocd \
        git \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The Cortex-M33 target, and the LLVM tools that read the resulting ELF.
RUN rustup target add thumbv8m.main-none-eabihf \
 && rustup component add llvm-tools-preview rustfmt clippy \
 && cargo install cargo-binutils --locked

# Generated by build scripts (bindgen output lives in OUT_DIR), never checked in.
ENV CARGO_TARGET_DIR=/build/target

WORKDIR /build

CMD ["bash", "scripts/gate.sh"]
